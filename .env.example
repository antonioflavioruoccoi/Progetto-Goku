# Public browser configuration; NEVER put a service_role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Local PostgreSQL integration tests only (not used by the application).
TEST_DATABASE_URL=postgresql://postgres:goku-local-tests@127.0.0.1:55432/postgres
# Optional backend-only bootstrap. Never ship these to a browser or hosting public files.
# Use the direct or session-pooler PostgreSQL URL from Supabase Connect.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DB_HOST:5432/postgres
ADMIN_EMAIL=owner@example.com
