{
  "name": "dr-goku",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": { "bindings": [{ "name": "GOKU", "class_name": "Goku" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Goku"] }],
  "build": { "command": "npm run build" },
}
